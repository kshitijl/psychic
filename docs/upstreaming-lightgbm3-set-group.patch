+    /// Set query groups, for ranking objectives such as `lambdarank`.
+    ///
+    /// Each value is the number of consecutive rows in one group, so the rows
+    /// of a group must be next to each other. `[3, 2]` puts the first three
+    /// rows in one group and the next two in another. The sizes must add up
+    /// to the number of rows.
+    ///
+    /// Example
+    /// ```
+    /// use lightgbm3::Dataset;
+    ///
+    /// let xs = vec![vec![1.0, 0.1], vec![0.7, 0.4], vec![0.9, 0.8], vec![0.2, 0.2], vec![0.1, 0.7]];
+    /// let labels = vec![0.0, 1.0, 0.0, 1.0, 0.0];
+    /// let mut dataset = Dataset::from_vec_of_vec(xs, labels, true).unwrap();
+    /// dataset.set_group(&[3, 2]).unwrap();
+    /// ```
+    pub fn set_group(&mut self, group: &[i32]) -> Result<()> {
+        let dataset_len = self.size()?.0 as i64;
+        let group_total: i64 = group.iter().map(|&size| size as i64).sum();
+        if dataset_len != group_total {
+            return Err(Error::new(format!(
+                "group sizes add up to {}, but dataset has {} records",
+                group_total, dataset_len
+            )));
+        }
+        let field_name = CString::new("group").unwrap();
+        lgbm_call!(lightgbm3_sys::LGBM_DatasetSetField(
+            self.handle,
+            field_name.as_ptr(),
+            group.as_ptr() as *const c_void,
+            group.len() as i32,
+            C_API_DTYPE_INT32 as i32, // groups other than int32 are not supported by LightGBM
+        ))?;
+        Ok(())
+    }
 }
 
